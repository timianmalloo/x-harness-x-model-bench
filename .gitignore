.env
.env.*
!.env.example

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# AI-Forward Pack (INSTALL 2): local coordination and per-run state, never committed
*.jsonl.lock
spikes/
docs/audit/.run-starts.json
docs/audit/.run-starts.json.tmp
.agents/*
!.agents/artifacts.yml
!.agents/log/
!.agents/skills*
!.agents/hooks.json
!.agents/rules*
