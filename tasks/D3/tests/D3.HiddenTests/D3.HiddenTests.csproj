<Project Sdk="Microsoft.NET.Sdk">
  <!-- The base workspace already declares CfdBench.Core with stub bodies (NotImplementedException), so this
       reference is unconditional: the base builds and every behavioural test fails at run time, never at compile
       time (a compile-only failure would grade NA under DR-G4, not 0). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <ProjectReference Include="../src/CfdBench.Core/CfdBench.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
