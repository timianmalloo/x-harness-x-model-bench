build/
# A vendored task base is committed byte for byte (R-42): never let a Python-build pattern hide part of it (VEND-A).
!/tasks/*/workspace/**/dist/
!/tasks/*/workspace/**/build/

# Benchmark run state (archived runs are published deliberately, never by accident)
runs/
work/
results.duckdb
results.duckdb.wal
*.parquet

