/-!
Fold.lean -- a faithful, minimal Lean 4 translation of coord-core.py's `fold` function
(`ai-forward` pack/scripts/coord-core.py, pinned commit
b647a34c20e6accab7fe9c11000496173f44f684, Apache-2.0). See `../../oracle/README.md` for the
field-by-field correspondence to the Python.

FROZEN: do not edit this file. Editing it voids `statement_integrity` (task.yaml
`formal.statement_hash`) and, with it, this task's other formal scores. Prove the theorems in
`Statements.lean` instead.
-/

/-- One coordination event: a claim or a release, identified by `(sess, seq)` for the
    replay-safety dedup (coord-core.py `fold`: `ident = (event.get("session"), event.get("seq"))`).
    `key` stands in for the Python lease key `(path, session)`: the Python fold only ever tests
    two keys for equality, never inspects their structure, so a single `Nat` captures the same
    behaviour for these theorems (see `../../oracle/README.md` S3). -/
structure Event where
  sess      : Nat
  seq       : Nat
  key       : Nat
  isClaim   : Bool   -- true = Python `event["kind"] == "claim"`, false = "release"
  expiresAt : Nat     -- Python computes `at + ttl` before folding (DM7); already computed here
  deriving DecidableEq, Repr

abbrev EventId := Nat × Nat   -- (sess, seq)

def Event.id (e : Event) : EventId := (e.sess, e.seq)

/-- The live-lease store: an association list from `key` to `expiresAt`, mirroring the Python
    `leases: dict[key, {...}]` (only `expires` matters to these theorems). -/
abbrev Store := List (Nat × Nat)

/-- Python `leases[key] = {...}` -- set/replace the entry for `key`. -/
def Store.set (s : Store) (k v : Nat) : Store :=
  (k, v) :: s.filter (fun p => p.1 != k)

/-- Python `leases.pop(key, None)` -- drop the entry for `key`, if any. -/
def Store.drop (s : Store) (k : Nat) : Store :=
  s.filter (fun p => p.1 != k)

/-- One step of the fold: coord-core.py's per-event loop body, dedup included:
    ```
    ident = (event.get("session"), event.get("seq"))
    if ident in seen: continue
    seen.add(ident)
    if event.kind == "claim": leases[key] = {...}
    elif event.kind == "release": leases.pop(key, None)
    ``` -/
def step (acc : Store × List EventId) (e : Event) : Store × List EventId :=
  if acc.2.contains e.id then
    acc                                                -- F9: a retried event changes nothing
  else if e.isClaim then
    (acc.1.set e.key e.expiresAt, e.id :: acc.2)
  else
    (acc.1.drop e.key, e.id :: acc.2)

/-- `foldRaw`: coord-core.py's `leases, seen = {}, set(); for event in events: ...` loop, before
    the final `now`-filter. -/
def foldRaw (events : List Event) : Store × List EventId :=
  events.foldl step (([], []))

/-- `fold`: coord-core.py's `fold(events, now)` -- the raw store filtered to unexpired leases
    (`{k: v for k, v in leases.items() if v["expires"] > now}`). -/
def fold (events : List Event) (now : Nat) : Store :=
  (foldRaw events).1.filter (fun p => now < p.2)
