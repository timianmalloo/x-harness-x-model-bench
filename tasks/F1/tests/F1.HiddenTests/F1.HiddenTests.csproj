<Project Sdk="Microsoft.NET.Sdk">
  <!-- The reference to the agent's library is conditional so that the base tree, which has no code, still builds
       this project and runs every test to a runtime failure (a compile-only failure would grade NA, not 0). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <ProjectReference Include="../src/CfdBench.Core/CfdBench.Core.csproj" Condition="Exists('../src/CfdBench.Core/CfdBench.Core.csproj')" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
